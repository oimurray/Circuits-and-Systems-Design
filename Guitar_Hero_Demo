// ═══════════════════════════════════════════════════════════════════════
//  VISUAL NOTE STATE
// ═══════════════════════════════════════════════════════════════════════
#define MAX_NOTES  20

struct VisualNote {
  bool    active;
  uint8_t lane;
  float   y;
  int16_t prevY;
};

VisualNote notes[MAX_NOTES];

// ═══════════════════════════════════════════════════════════════════════
//  GAME STATE
// ═══════════════════════════════════════════════════════════════════════
int      score      = 0;
int      combo      = 0;
int      beatmapIdx = 0;
volatile uint32_t gameStartMs = 0;

bool fretState[NUM_LANES]     = {};
bool fretPrevState[NUM_LANES] = {};

bool strumUp = false;
bool strumDown = false;
bool prevStrumUp = false;
bool prevStrumDown = false;

int joyY;

bool rawUp   = joyY > STRUM_UP_THRESHOLD;
bool rawDown = joyY < STRUM_DOWN_THRESHOLD;

int prevScore = -1;
int prevCombo = -1;

struct FlashState { bool active; uint8_t lane; uint32_t endMs; };
FlashState flash = { false, 0, 0 };

// ═══════════════════════════════════════════════════════════════════════
//  DRAWING HELPERS
// ═══════════════════════════════════════════════════════════════════════
void eraseNote(int i) {
  if (notes[i].prevY < 0) return;
  tft.fillCircle(laneCX[notes[i].lane],
                 notes[i].prevY + NOTE_RADIUS,
                 NOTE_RADIUS + 1, C_GREY);
}

void drawNote(int i) {
  int cx = laneCX[notes[i].lane];
  int cy = (int)notes[i].y + NOTE_RADIUS;
  tft.fillCircle(cx, cy, NOTE_RADIUS, LANE_COLORS[notes[i].lane]);
  tft.drawCircle(cx, cy, NOTE_RADIUS, C_WHITE);
  notes[i].prevY = (int16_t)notes[i].y;
}

void drawHitZones() {
  for (int i = 0; i < NUM_LANES; i++) {
    tft.drawCircle(laneCX[i], HIT_ZONE_Y, HIT_ZONE_R,     LANE_COLORS[i]);
    tft.drawCircle(laneCX[i], HIT_ZONE_Y, HIT_ZONE_R - 1, LANE_COLORS[i]);
  }
}

void updateScoreDisplay() {
  if (score != prevScore) {
    tft.fillRect(0, 0, SCREEN_W, 28, C_BLACK);
    tft.setCursor(4, 6);
    tft.setTextColor(C_WHITE, C_BLACK);
    tft.setTextSize(2);
    tft.print("Score: ");
    tft.print(score);
    prevScore = score;
  }
  if (combo != prevCombo) {
    tft.fillRect(0, 30, SCREEN_W, 22, C_BLACK);
    if (combo > 1) {
      tft.setCursor(4, 32);
      tft.setTextColor(C_YELLOW, C_BLACK);
      tft.setTextSize(2);
      tft.print("Combo x");
      tft.print(combo);
    }
    prevCombo = combo;
  }
}

// ═══════════════════════════════════════════════════════════════════════
//  SETUP
// ═══════════════════════════════════════════════════════════════════════
void setup() {
  Serial.begin(115200);
  Serial.println("Booting...");

  for (int i = 0; i < NUM_LANES; i++)
    pinMode(FRET_PINS[i], INPUT_PULLUP);
  //pinMode(PIN_STRUM, INPUT_PULLUP);

  for (int i = 0; i < NUM_LANES; i++)
    laneCX[i] = LANE_MARGIN + i * (LANE_W + LANE_GAP) + LANE_W / 2;

  tft.init();
  tft.setRotation(ROTATION);
  tft.fillScreen(C_BLACK);
  Serial.println("Display OK");

  for (int i = 0; i < NUM_LANES; i++)
    tft.fillRect(LANE_MARGIN + i * (LANE_W + LANE_GAP), 55,
                 LANE_W, SCREEN_H - 55 - 10, C_GREY);

  drawHitZones();

  for (int i = 0; i < MAX_NOTES; i++) {
    notes[i].active = false;
    notes[i].prevY  = -1;
  }

  updateScoreDisplay();

  // ── Sine table ────────────────────────────────────────────────────
  for (int i = 0; i < TABLE_SIZE; i++)
    sineTable[i] = (uint8_t)(127.5f + 127.5f * sinf(2.0f * PI * i / TABLE_SIZE));

  // ── Hardware timer for DAC ISR ────────────────────────────────────
  audioTimer = timerBegin(TIMER_FREQ);
  timerAttachInterrupt(audioTimer, &onTimer);
  timerAlarm(audioTimer, 1, true, 0);

  buildBeatmap();

  tft.setCursor(60, 220);
  tft.setTextColor(C_WHITE, C_BLACK);
  tft.setTextSize(4);
  tft.print("READY?");
  delay(2000);
  tft.fillRect(0, 200, SCREEN_W, 80, C_BLACK);

  // ── Launch audio task on Core 0 ───────────────────────────────────
  xTaskCreatePinnedToCore(audioTask, "AudioTask", 2048, NULL, 1, NULL, 0);

  gameStartMs = millis();
  Serial.println("Game started");
}

// ═══════════════════════════════════════════════════════════════════════
//  LOOP  (Core 1)
// ═══════════════════════════════════════════════════════════════════════
void loop() {
  static uint32_t lastMs = 0;
  uint32_t nowMs  = millis();
  uint32_t gameMs = nowMs - gameStartMs;
  float    dt     = (nowMs - lastMs) / 1000.0f;
  lastMs = nowMs;

  // ── 1. Read fret buttons ───────────────────────────────────────────
  for (int i = 0; i < NUM_LANES; i++) {
    fretState[i]     = (digitalRead(FRET_PINS[i]) == LOW);
    fretPrevState[i] = fretState[i];
  }

  // ── 2. Read strum button ───────────────────────────────────────────
  int joyY = analogRead(PIN_STRUM);
  bool rawUp   = joyY > STRUM_UP_THRESHOLD;
  bool rawDown = joyY < STRUM_DOWN_THRESHOLD;

  strumUp   = rawUp   && !prevStrumUp;    // rising edge only
  strumDown = rawDown && !prevStrumDown;

  prevStrumUp   = rawUp;
  prevStrumDown = rawDown;

  // ── 3. Spawn notes ─────────────────────────────────────────────────
  uint32_t travelMs = (uint32_t)(
    ((float)(HIT_ZONE_Y + NOTE_RADIUS * 2) / NOTE_SPEED) * 1000.0f);

  while (beatmapIdx < BEATMAP_LEN) {
    uint32_t arrMs = BEATMAP[beatmapIdx].arrivalMs;
    if (gameMs + travelMs >= arrMs) {
      for (int i = 0; i < MAX_NOTES; i++) {
        if (!notes[i].active) {
          notes[i].active = true;
          notes[i].lane   = BEATMAP[beatmapIdx].lane;
          notes[i].y      = -(float)(NOTE_RADIUS * 2);
          notes[i].prevY  = -1;
          break;
        }
      }
      beatmapIdx++;
    } else {
      break;
    }
  }

  // ── 4. Move notes downward ─────────────────────────────────────────
  for (int i = 0; i < MAX_NOTES; i++) {
    if (!notes[i].active) continue;
    eraseNote(i);
    notes[i].y += NOTE_SPEED * dt;
    if (notes[i].y > SCREEN_H + NOTE_RADIUS) {
      notes[i].active = false;
      combo     = 0;
      prevCombo = -1;
    }
  }

  // ── 5. Hit detection (strum triggers check) ────────────────────────
  if (strumUp && strumDown) {
    bool anyHit = false;

    for (int lane = 0; lane < NUM_LANES; lane++) {
      if (!fretState[lane]) continue;

      int   bestIdx  = -1;
      float bestDist = HIT_WINDOW + 1.0f;

      for (int i = 0; i < MAX_NOTES; i++) {
        if (!notes[i].active || notes[i].lane != lane) continue;
        float cy   = notes[i].y + NOTE_RADIUS;
        float dist = fabsf(cy - (float)HIT_ZONE_Y);
        if (dist <= HIT_WINDOW && dist < bestDist) {
          bestDist = dist;
          bestIdx  = i;
        }
      }

      if (bestIdx >= 0) {
        eraseNote(bestIdx);
        notes[bestIdx].active = false;
        score += 10 + combo;
        combo++;
        anyHit = true;
        flash.active = true;
        flash.lane   = lane;
        flash.endMs  = nowMs + 60;
        tft.fillCircle(laneCX[lane], HIT_ZONE_Y, HIT_ZONE_R, C_WHITE);
        Serial.printf("HIT  lane=%d  score=%d  combo=%d\n", lane, score, combo);
      }
    }

    if (!anyHit) {
      combo     = 0;
      prevCombo = -1;
      Serial.println("MISS");
    }
  }

  // ── 6. Resolve hit flash ───────────────────────────────────────────
  if (flash.active && nowMs >= flash.endMs) {
    flash.active = false;
    int lane = flash.lane;
    tft.fillCircle(laneCX[lane], HIT_ZONE_Y, HIT_ZONE_R, C_BLACK);
    tft.drawCircle(laneCX[lane], HIT_ZONE_Y, HIT_ZONE_R,     LANE_COLORS[lane]);
    tft.drawCircle(laneCX[lane], HIT_ZONE_Y, HIT_ZONE_R - 1, LANE_COLORS[lane]);
  }

  // ── 7. Draw active notes ───────────────────────────────────────────
  for (int i = 0; i < MAX_NOTES; i++)
    if (notes[i].active) drawNote(i);

  // ── 8. Hit zone fret-hold feedback ────────────────────────────────
  for (int i = 0; i < NUM_LANES; i++) {
    if (flash.active && flash.lane == i) continue;
    if (fretState[i]) {
      tft.fillCircle(laneCX[i], HIT_ZONE_Y, HIT_ZONE_R, LANE_COLORS[i]);
    } else {
      tft.fillCircle(laneCX[i], HIT_ZONE_Y, HIT_ZONE_R, C_BLACK);
      tft.drawCircle(laneCX[i], HIT_ZONE_Y, HIT_ZONE_R,     LANE_COLORS[i]);
      tft.drawCircle(laneCX[i], HIT_ZONE_Y, HIT_ZONE_R - 1, LANE_COLORS[i]);
    }
  }

  // ── 9. Score / combo HUD ───────────────────────────────────────────
  updateScoreDisplay();

  // ── 10. End-of-song ────────────────────────────────────────────────
  if (beatmapIdx >= BEATMAP_LEN) {
    bool anyActive = false;
    for (int i = 0; i < MAX_NOTES; i++)
      if (notes[i].active) { anyActive = true; break; }

    if (!anyActive) {
      tft.fillScreen(C_BLACK);
      tft.setCursor(40, 180);
      tft.setTextColor(C_YELLOW, C_BLACK);
      tft.setTextSize(3);
      tft.println("SONG CLEAR!");
      tft.setCursor(60, 230);
      tft.setTextColor(C_WHITE, C_BLACK);
      tft.setTextSize(2);
      tft.print("Score: ");
      tft.println(score);
      dacWrite(DAC_PIN, 128);
      while (true);
    }
  }
}

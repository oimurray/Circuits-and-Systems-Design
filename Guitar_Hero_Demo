/*
 * Guitar Hero Style Game — ESP32 + ST7796S
 * - Game logic runs on Core 1 (Arduino default loop)
 * - Audio (DAC sine wave) runs on Core 0 via FreeRTOS task
 * - Beatmap arrival times are derived from song note durations
 *   so button prompts are perfectly synced with the audio.
 *
 * ─── WIRING ───────────────────────────────────────────────────────────
 *   VCC   → 3.3V
 *   GND   → GND
 *   CS    → GPIO 5
 *   RESET → GPIO 4
 *   DC/RS → GPIO 2
 *   MOSI  → GPIO 23
 *   SCK   → GPIO 18
 *   LED   → 3.3V
 *   MISO  → not connected
 *
 *   DAC out → GPIO 25 → amp circuit
 *
 *   Fret buttons (active LOW, INPUT_PULLUP):
 *     Lane 0 Red    → GPIO 12
 *     Lane 1 Green  → GPIO 13
 *     Lane 2 Yellow → GPIO 14
 *     Lane 3 Blue   → GPIO 27
 *
 *   Strum button (active LOW, INPUT_PULLUP):
 *     Strum         → GPIO 26
 *
*/
// ═══════════════════════════════════════════════════════════════════════
//  INCLUDES
// ═══════════════════════════════════════════════════════════════════════
#include <Arduino.h>
#include <TFT_eSPI.h>
#include <SPI.h>
#include <math.h>

// ═══════════════════════════════════════════════════════════════════════
//  PIN DEFINITIONS
// ═══════════════════════════════════════════════════════════════════════
#define DAC_PIN  25   // ESP32 DAC channel 1

const uint8_t FRET_PINS[4] = { 12, 13, 14, 27 };
#define PIN_STRUM  35

// ═══════════════════════════════════════════════════════════════════════
//  DISPLAY
// ═══════════════════════════════════════════════════════════════════════
#define SCREEN_W  320
#define SCREEN_H  480
#define ROTATION  0

TFT_eSPI tft = TFT_eSPI();

// ═══════════════════════════════════════════════════════════════════════
//  COLOURS
// ═══════════════════════════════════════════════════════════════════════
#define C_BLACK   0x0000
#define C_WHITE   0xFFFF
#define C_RED     0xF800
#define C_GREEN   0x07E0
#define C_YELLOW  0xFFE0
#define C_BLUE    0x001F
#define C_GREY    0x2945

const uint16_t LANE_COLORS[4] = { C_RED, C_GREEN, C_YELLOW, C_BLUE };

// ═══════════════════════════════════════════════════════════════════════
//  GAME LAYOUT CONSTANTS
// ═══════════════════════════════════════════════════════════════════════
#define NUM_LANES    4
#define LANE_W       70
#define LANE_GAP      5
#define NOTE_RADIUS  22
#define HIT_ZONE_Y   430
#define HIT_ZONE_R    26
#define HIT_WINDOW    40
#define NOTE_SPEED   100
#define LANE_MARGIN   13

#define STRUM_UP_THRESHOLD 2200
#define STRUM_DOWN_THRESHOLD 1800

int laneCX[NUM_LANES];

// ═══════════════════════════════════════════════════════════════════════
//  AUDIO ENGINE  (Core 0)
// ═══════════════════════════════════════════════════════════════════════
#define TABLE_SIZE  256
#define TIMER_FREQ  112640

uint8_t sineTable[TABLE_SIZE];
hw_timer_t *audioTimer = NULL;

volatile uint32_t gPhaseStep = 0;
volatile uint32_t gPhase     = 0;
volatile bool     gPlaying   = false;

void IRAM_ATTR onTimer() {
  if (!gPlaying) {
    dacWrite(DAC_PIN, 128);
    return;
  }
  gPhase += gPhaseStep;
  if (gPhase >= (uint32_t)TABLE_SIZE * 1000)
    gPhase -= (uint32_t)TABLE_SIZE * 1000;
  dacWrite(DAC_PIN, sineTable[gPhase / 1000]);
}

void audioSetNote(float freq) {
  if (freq == 0.0f) {
    gPlaying = false;
    return;
  }
  uint32_t step = (uint32_t)(((float)TABLE_SIZE * freq) / (float)TIMER_FREQ * 1000.0f);
  gPhase     = 0;
  gPhaseStep = step;
  gPlaying   = true;
}

// ═══════════════════════════════════════════════════════════════════════
//  SONG / BEATMAP
//  Each SongNote: freq (Hz), durMs, lane (0-3)
//  buildBeatmap() derives visual note arrival times from durations
//  so audio and on-screen notes are always in sync.
// ═══════════════════════════════════════════════════════════════════════
#define C4   261.63f
#define D4   293.66f
#define E4   329.63f
#define F4   349.23f
#define G4   392.00f
#define A4   440.00f
#define REST   0.0f

struct SongNote {
  float    freq;
  uint32_t durMs;
  uint8_t  lane;
};

// Twinkle Twinkle Little Star
const SongNote SONG[] = {
  //freq  dur   lane
  { C4,  400,  0 },   //  0  Red
  { C4,  400,  1 },   //  1  Green
  { G4,  400,  2 },   //  2  Yellow
  { G4,  400,  3 },   //  3  Blue
  { A4,  400,  0 },   //  4  Red
  { A4,  400,  1 },   //  5  Green
  { G4,  800,  2 },   //  6  Yellow  (long)
  { F4,  400,  3 },   //  7  Blue
  { F4,  400,  0 },   //  8  Red
  { E4,  400,  1 },   //  9  Green
  { E4,  400,  2 },   // 10  Yellow
  { D4,  400,  3 },   // 11  Blue
  { D4,  400,  0 },   // 12  Red
  { C4,  800,  1 },   // 13  Green   (long)
  { G4,  400,  2 },   // 14  Yellow
  { G4,  400,  3 },   // 15  Blue
  { F4,  400,  0 },   // 16  Red
  { F4,  400,  1 },   // 17  Green
  { E4,  400,  2 },   // 18  Yellow
  { E4,  400,  3 },   // 19  Blue
  { D4,  800,  0 },   // 20  Red     (long)
};
const int SONG_LENGTH = sizeof(SONG) / sizeof(SONG[0]);

struct BeatmapEntry {
  uint32_t arrivalMs;
  uint8_t  lane;
};

BeatmapEntry BEATMAP[sizeof(SONG) / sizeof(SONG[0])];
int BEATMAP_LEN = 0;

void buildBeatmap() {
  uint32_t t = 0;
  BEATMAP_LEN = 0;
  for (int i = 0; i < SONG_LENGTH; i++) {
    if (SONG[i].freq != REST) {
      BEATMAP[BEATMAP_LEN].arrivalMs = t + SONG[i].durMs / 2;
      BEATMAP[BEATMAP_LEN].lane      = SONG[i].lane;
      BEATMAP_LEN++;
    }
    t += SONG[i].durMs;
  }
}

// ═══════════════════════════════════════════════════════════════════════
//  AUDIO TASK  (Core 0)
// ═══════════════════════════════════════════════════════════════════════
void audioTask(void *pvParameters) {
  extern volatile uint32_t gameStartMs;
  while (gameStartMs == 0) vTaskDelay(1);

  for (int i = 0; i < SONG_LENGTH; i++) {
    audioSetNote(SONG[i].freq);
    uint32_t onMs  = (uint32_t)(SONG[i].durMs * 0.85f);
    uint32_t offMs = SONG[i].durMs - onMs;
    vTaskDelay(pdMS_TO_TICKS(onMs));
    gPlaying = false;
    vTaskDelay(pdMS_TO_TICKS(offMs));
  }
  dacWrite(DAC_PIN, 128);   // silence after song ends
  vTaskDelete(NULL);
}

